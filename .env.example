# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pharma_dw
POSTGRES_USER=dw_admin
POSTGRES_PASSWORD=pharma_secure_pass_2025
DATABASE_URL=postgresql://dw_admin:pharma_secure_pass_2025@localhost:5432/pharma_dw

# Read-Only Semantic Role (for Text-to-SQL Agent)
RO_POSTGRES_USER=pharma_analyst_ro
RO_POSTGRES_PASSWORD=ro_secure_analyst_2025
RO_DATABASE_URL=postgresql://pharma_analyst_ro:ro_secure_analyst_2025@localhost:5432/pharma_dw

# LLM provider used by the Text-to-SQL agent. Keys can also be entered for a
# single Streamlit session in the sidebar; session-entered keys are not saved.
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Pipeline & Alerts
DATA_DIR=./data
SLACK_WEBHOOK_URL=
ALERT_EMAIL_RECIPIENT=alerts@commercialops.pharma.internal
LOG_LEVEL=INFO
